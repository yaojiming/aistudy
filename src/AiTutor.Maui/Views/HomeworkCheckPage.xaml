<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             x:Class="AiTutor.Maui.Views.HomeworkCheckPage"
             Shell.NavBarIsVisible="False"
             Title="作业检查">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="76,*">
        <!-- 顶部工具栏 -->
        <Grid Padding="30,12" ColumnDefinitions="Auto,*,158,158,184,Auto,Auto" ColumnSpacing="14" BackgroundColor="#FFFFFF">
            <Button Text="‹"
                    FontSize="30"
                    FontAttributes="Bold"
                    BackgroundColor="#F5F8FC"
                    TextColor="#2A405C"
                    CornerRadius="15"
                    Padding="0"
                    WidthRequest="54"
                    HeightRequest="54"
                    Command="{Binding BackCommand}" />
            <Border BackgroundColor="#FFF7ED" StrokeThickness="0" WidthRequest="48" HeightRequest="48" Margin="10,0,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="检" FontSize="24" FontAttributes="Bold" TextColor="#EA580C" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Text="作业检查" FontSize="24" Margin="70,0,0,0" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center" />
            <Picker Grid.Column="2" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" FontSize="15" BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="3" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" FontSize="15" BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="4" ItemsSource="{Binding ThinkingModes}" SelectedItem="{Binding SelectedThinkingMode}" FontSize="15" BackgroundColor="#F8FAFC" />
            <Button Grid.Column="5" Text="选择图片" FontSize="15" FontAttributes="Bold" WidthRequest="116" HeightRequest="44" CornerRadius="16" BackgroundColor="#2563EB" TextColor="#FFFFFF" Command="{Binding PickImageCommand}" />
            <Button Grid.Column="6" Text="拍照" FontSize="15" FontAttributes="Bold" WidthRequest="92" HeightRequest="44" CornerRadius="16" BackgroundColor="#EA580C" TextColor="#FFFFFF" Command="{Binding CapturePhotoCommand}" />
        </Grid>

        <!-- 内容区：左侧图片 + OCR 框选（含对错标注），右侧答案区 -->
        <Grid Grid.Row="1" ColumnDefinitions="0.5*,1*" ColumnSpacing="0">
            <!-- 左侧：图片预览 + OCR 题目框选 + 对错标注 -->
            <Grid Padding="10" BackgroundColor="#0F172A">
                <Border Padding="14" BackgroundColor="#111827" Stroke="#334155" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="34" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Aspect="AspectFit" />
                        <controls:QuestionRegionOverlayView Regions="{Binding QuestionRegions}"
                                                            SelectedRegionId="{Binding SelectedQuestionRegionId}"
                                                            ImagePixelWidth="{Binding ImagePixelWidth}"
                                                            ImagePixelHeight="{Binding ImagePixelHeight}"
                                                            RegionResults="{Binding RegionResults}"
                                                            RegionTappedCommand="{Binding SelectQuestionRegionCommand}" />
                        <controls:EmptyStateView TitleText="拍摄或选择整页作业"
                                                 DescriptionText="图片会显示在这里"
                                                 IconText="检"
                                                 IsVisible="{Binding HasPreview, Converter={StaticResource InvertedBoolConverter}}" />
                        <Border Padding="10,6"
                                Margin="18"
                                BackgroundColor="#CC0F172A"
                                StrokeThickness="0"
                                IsVisible="{Binding HasRegionHint}"
                                VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding RegionHintText}"
                                   FontSize="13"
                                   TextColor="#FFFFFF"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧：标题栏 → 答案区 → 底部按钮（完全参考拍照讲题：无外层 ScrollView，FormattedAnswerView/CollectionView 各自处理滚动） -->
            <Grid Grid.Column="1"
                  BackgroundColor="#FFFFFF"
                  Padding="28,20"
                  RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="14">

                <!-- 标题 -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="批改结果" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
                    <Label FontSize="13" TextColor="#94A3B8">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsThinkingComplete}" Value="True">
                                <Setter Property="Text" Value="点击左侧题目框查看逐题详情" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsThinkingComplete}" Value="False">
                                <Setter Property="Text" Value="AI老师正在分析..." />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <ProgressBar Grid.Row="1" Progress="{Binding UploadProgress}" ProgressColor="#EA580C" BackgroundColor="#E2E8F0" HeightRequest="6" />

                <!-- 阶段 1：思考中 —— FormattedAnswerView 填充整行，由内部 WebView 滚动 -->
                <Border Grid.Row="2"
                        Padding="20"
                        BackgroundColor="#EFF6FF"
                        Stroke="#DBEAFE"
                        IsVisible="{Binding IsThinkingComplete, Converter={StaticResource InvertedBoolConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="AI 老师思考中..." FontSize="16" FontAttributes="Bold" TextColor="#2563EB" />
                        <controls:FormattedAnswerView Text="{Binding ResultText}"
                                                      AnswerFontSize="16"
                                                      AnswerTextColor="#334155" />
                    </VerticalStackLayout>
                </Border>

                <!-- 阶段 2：思考完成 —— 折叠思考（Auto）+ 选题详情（Auto）+ 题目列表（*，CollectionView 内部滚动） -->
                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="14"
                      IsVisible="{Binding IsThinkingComplete}">

                    <!-- 思考过程折叠区 -->
                    <Border Padding="14,10"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="思考过程" FontSize="15" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{Binding ThinkingToggleText}" FontSize="13"
                                        WidthRequest="84" HeightRequest="32" CornerRadius="12"
                                        BackgroundColor="#F1F5F9" TextColor="#64748B"
                                        Command="{Binding ToggleThinkingCommand}" />
                            </Grid>
                            <controls:FormattedAnswerView Text="{Binding ResultText}"
                                                          AnswerFontSize="14"
                                                          AnswerTextColor="#94A3B8"
                                                          MaximumHeightRequest="250" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 选中题目详情卡片 -->
                    <Border Grid.Row="1"
                            Padding="20"
                            BackgroundColor="{Binding SelectedHomeworkItem.CardColor}"
                            Stroke="#F1E4D1"
                            StrokeThickness="2"
                            IsVisible="{Binding HasSelectedHomeworkItem}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label FontSize="20" FontAttributes="Bold" TextColor="#1E293B"
                                       Text="{Binding SelectedHomeworkItem.QuestionNo}" />
                                <Border Grid.Column="1" Padding="14,6" BackgroundColor="#FFFFFF" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Label Text="{Binding SelectedHomeworkItem.StatusText}" FontSize="14" FontAttributes="Bold" TextColor="#EA580C" />
                                </Border>
                            </Grid>
                            <Label FontSize="17" FontAttributes="Bold" TextColor="#1E293B"
                                   Text="{Binding SelectedHomeworkItem.QuestionText}" />
                            <BoxView HeightRequest="1" Color="#E2E8F0" />
                            <controls:FormattedAnswerView Text="{Binding SelectedHomeworkItem.DetailText}"
                                                          AnswerFontSize="15"
                                                          AnswerTextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 全部题目列表：CollectionView 内部滚动，不依赖外层 ScrollView -->
                    <CollectionView Grid.Row="2" ItemsSource="{Binding HomeworkItems}">
                        <CollectionView.Header>
                            <Label Text="全部题目" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" Margin="0,4,0,8" />
                        </CollectionView.Header>
                        <CollectionView.EmptyView>
                            <controls:EmptyStateView TitleText="暂无检查结果"
                                                     DescriptionText="上传作业图片后，逐题检查结果会展示在这里。"
                                                     IconText="作" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                                              Command="{Binding BindingContext.SelectHomeworkItemCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <controls:HomeworkResultCard QuestionNo="{Binding QuestionNo}"
                                                                 StatusText="{Binding StatusText}"
                                                                 QuestionText="{Binding QuestionText}"
                                                                 DetailText="{Binding DetailText}"
                                                                 CardColor="{Binding CardColor}"
                                                                 ExplainCommand="{Binding BindingContext.ExplainCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                                 AddWrongCommand="{Binding BindingContext.AddWrongCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                                 PracticeCommand="{Binding BindingContext.PracticeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- 底部按钮（常驻） -->
                <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <Button Text="上传并检查"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#EA580C"
                            TextColor="#FFFFFF"
                            Command="{Binding SubmitCommand}" />
                    <Button Grid.Column="1"
                            Text="只看错题"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#FFF7ED"
                            TextColor="#EA580C"
                            Command="{Binding ToggleWrongOnlyCommand}" />
                    <Button Grid.Column="2"
                            Text="错题本"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#F1F5F9"
                            TextColor="#64748B" />
                </Grid>
            </Grid>
        </Grid>

        <controls:LoadingOverlay Grid.RowSpan="2" IsLoading="{Binding IsBlockingLoading}" LoadingText="AI老师正在检查..." />
    </Grid>
</ContentPage>
