<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             x:Class="AiTutor.Maui.Views.HomeworkCheckPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="检查作业">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="76,*">
        <Grid Padding="30,12"
              ColumnDefinitions="*,150,150,210,140,Auto,Auto"
              ColumnSpacing="14"
              BackgroundColor="#FFFFFF">
            <HorizontalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Start">
                <Button Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        BackgroundColor="#F5F8FC"
                        TextColor="#2A405C"
                        CornerRadius="15"
                        Padding="0"
                        WidthRequest="54"
                        HeightRequest="54"
                        Command="{Binding BackCommand}" />

                <Border BackgroundColor="#DCEBFF"
                        StrokeThickness="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        Margin="10,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="检"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#246BFF"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Spacing="0" VerticalOptions="Center" Margin="12,0,0,0">
                    <Label Text="检查作业" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
                    <Label Text="{Binding LatestStatusMessage}" FontSize="12" TextColor="#94A3B8" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Picker Grid.Column="1"
                    ItemsSource="{Binding Grades}"
                    SelectedItem="{Binding SelectedGrade}"
                    FontSize="15"
                    BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="2"
                    ItemsSource="{Binding Subjects}"
                    SelectedItem="{Binding SelectedSubject}"
                    FontSize="15"
                    BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="3"
                    ItemsSource="{Binding ModelNames}"
                    SelectedItem="{Binding SelectedModelName}"
                    FontSize="15"
                    BackgroundColor="#F8FAFC" />
            <HorizontalStackLayout Grid.Column="4"
                                   Spacing="8"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                <Label Text="思考"
                       FontSize="14"
                       TextColor="#334155"
                       VerticalTextAlignment="Center" />
                <Switch IsToggled="{Binding IsThinkingModeEnabled}" />
            </HorizontalStackLayout>
            <Button Grid.Column="5"
                    Text="选择图片"
                    FontSize="15"
                    FontAttributes="Bold"
                    WidthRequest="116"
                    HeightRequest="44"
                    CornerRadius="16"
                    BackgroundColor="#2563EB"
                    TextColor="#FFFFFF"
                    Command="{Binding PickImageCommand}" />
            <Button Grid.Column="6"
                    Text="拍照"
                    FontSize="15"
                    FontAttributes="Bold"
                    WidthRequest="92"
                    HeightRequest="44"
                    CornerRadius="16"
                    BackgroundColor="#0F766E"
                    TextColor="#FFFFFF"
                    Command="{Binding CapturePhotoCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="0.5*,1*" ColumnSpacing="0">
            <Grid Padding="10" BackgroundColor="#0F172A">
                <Border Padding="14" BackgroundColor="#111827" Stroke="#334155" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="34" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Aspect="AspectFit" />
                        <controls:QuestionRegionOverlayView Regions="{Binding QuestionRegions}"
                                                            SelectedRegionId="{Binding SelectedQuestionRegionId}"
                                                            ImagePixelWidth="{Binding ImagePixelWidth}"
                                                            ImagePixelHeight="{Binding ImagePixelHeight}"
                                                            RegionTappedCommand="{Binding SelectQuestionRegionCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1"
                  BackgroundColor="#FFFFFF"
                  Padding="30"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="作业检查状态" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
                        <Label Text="{Binding ReturnedResultText}" FontSize="13" TextColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Padding="16,8"
                            BackgroundColor="#F1F5F9"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="{Binding AiStatusText}"
                               FontSize="14"
                               TextColor="#334155" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <VerticalStackLayout IsVisible="{Binding ShowNotStartedPanel}"
                                         Spacing="14"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">
                        <Label Text="请选择或拍摄一张作业图片"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalTextAlignment="Center" />
                        <Label Text="AI 会一次性检查整页作业，并返回每道题的结果。"
                               FontSize="15"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShowCheckingPanel}"
                                         Spacing="14">
                        <Border Padding="20"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding ClientStageText}" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                                <Label Text="{Binding LatestStatusMessage}" FontSize="15" TextColor="#475569" />
                                <Label Text="{Binding ReturnedResultText}" FontSize="15" TextColor="#2563EB" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <CollectionView IsVisible="{Binding ShowResultOverview}"
                                    ItemsSource="{Binding Questions}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="14,10"
                                        BackgroundColor="{Binding RowBackgroundColor}"
                                        Stroke="{Binding RowStrokeColor}"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="70,120,150,150,*"
                                          ColumnSpacing="14">
                                        <Label Text="{Binding QuestionNo, StringFormat='第 {0} 题'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B"
                                               VerticalTextAlignment="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding StatusIcon}" FontSize="19" TextColor="{Binding StatusColor}" />
                                            <Label Text="{Binding StatusText}" FontSize="16" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding StudentAnswerText}"
                                               FontSize="15"
                                               TextColor="#475569"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="3"
                                               Text="{Binding CorrectAnswerText}"
                                               FontSize="15"
                                               TextColor="#475569"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="4"
                                               Text="{Binding ResultSummary}"
                                               FontSize="15"
                                               TextColor="#64748B"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectQuestionCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ScrollView IsVisible="{Binding ShowQuestionDetail}">
                        <VerticalStackLayout Spacing="12">
                            <Button Text="返回结果列表"
                                    HorizontalOptions="Start"
                                    HeightRequest="40"
                                    CornerRadius="14"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#334155"
                                    Command="{Binding BackToResultListCommand}" />
                            <Label Text="{Binding SelectedQuestion.QuestionNo, StringFormat='第 {0} 题'}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />
                            <Label Text="{Binding SelectedQuestion.QuestionText}" FontSize="16" TextColor="#334155" />
                            <Label Text="{Binding SelectedQuestion.StudentAnswerText, StringFormat='学生答案：{0}'}" FontSize="16" TextColor="#475569" />
                            <Label Text="{Binding SelectedQuestion.CorrectAnswerText, StringFormat='正确答案：{0}'}" FontSize="16" TextColor="#475569" />
                            <Label Text="{Binding SelectedQuestion.Result.MistakeReason, StringFormat='错因分析：{0}'}" FontSize="16" TextColor="#475569" />
                            <Label Text="{Binding SelectedQuestion.DetailText}" FontSize="16" TextColor="#334155" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                    <Button Grid.Column="0"
                            Text="{Binding StartCheckButtonText}"
                            HeightRequest="54"
                            CornerRadius="18"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="#0F766E"
                            TextColor="#FFFFFF"
                            IsEnabled="{Binding CanStartCheck}"
                            Command="{Binding StartCheckCommand}" />
                    <Button Grid.Column="1"
                            Text="加入错题本"
                            HeightRequest="54"
                            CornerRadius="18"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="#EEF2F7"
                            TextColor="#94A3B8"
                            Command="{Binding AddWrongCommand}"
                            CommandParameter="{Binding SelectedQuestion}" />
                </Grid>

                <controls:LoadingOverlay IsLoading="{Binding IsBlockingLoading}" LoadingText="正在处理作业图片..." />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
