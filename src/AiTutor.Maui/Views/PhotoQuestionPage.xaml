<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             x:Class="AiTutor.Maui.Views.PhotoQuestionPage"
             Shell.NavBarIsVisible="False"
             Title="拍照讲题">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="76,*">
        <Grid Padding="30,12" ColumnDefinitions="*,150,150,210,140,Auto,Auto" ColumnSpacing="12" BackgroundColor="#FFFFFF">
            <HorizontalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Start">
                <Button Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        BackgroundColor="#F5F8FC"
                        TextColor="#2A405C"
                        CornerRadius="15"
                        Padding="0"
                        WidthRequest="54"
                        HeightRequest="54"
                        Command="{Binding BackCommand}" />

                <Border BackgroundColor="#DCEBFF" StrokeThickness="0" WidthRequest="48" HeightRequest="48" Margin="10,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="学" FontSize="24" FontAttributes="Bold" TextColor="#246BFF" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Text="拍照讲题" FontSize="24" Margin="10,0,0,0" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Picker Grid.Column="1" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" FontSize="15" BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="2" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" FontSize="15" BackgroundColor="#F8FAFC" />
            <Picker Grid.Column="3" ItemsSource="{Binding ModelNames}" SelectedItem="{Binding SelectedModelName}" FontSize="15" BackgroundColor="#F8FAFC" />
            <HorizontalStackLayout Grid.Column="4"
                                   Spacing="8"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                <Label Text="思考"
                       FontSize="14"
                       TextColor="#334155"
                       VerticalTextAlignment="Center" />
                <Switch IsToggled="{Binding IsThinkingModeEnabled}" />
            </HorizontalStackLayout>
            <Button Grid.Column="5" Text="选择图片" FontSize="15" FontAttributes="Bold" WidthRequest="116" HeightRequest="44" CornerRadius="16" BackgroundColor="#2563EB" TextColor="#FFFFFF" Command="{Binding PickImageCommand}" />
            <Button Grid.Column="6" Text="拍照" FontSize="15" FontAttributes="Bold" WidthRequest="92" HeightRequest="44" CornerRadius="16" BackgroundColor="#0F766E" TextColor="#FFFFFF" Command="{Binding CapturePhotoCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="0.5*,1*" ColumnSpacing="0">
            <Grid Padding="10" BackgroundColor="#0F172A">
                <Border Padding="14" BackgroundColor="#111827" Stroke="#334155" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="34" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Aspect="AspectFit" />
                        <controls:QuestionRegionOverlayView Regions="{Binding QuestionRegions}"
                                                            SelectedRegionId="{Binding SelectedQuestionRegionId}"
                                                            ImagePixelWidth="{Binding ImagePixelWidth}"
                                                            ImagePixelHeight="{Binding ImagePixelHeight}"
                                                            RegionTappedCommand="{Binding SelectQuestionRegionCommand}" />
                        <controls:EmptyStateView TitleText="请拍摄或选择题目照片"
                                                 DescriptionText="图片会显示在这里"
                                                 IconText="拍"
                                                 IsVisible="{Binding HasPreview, Converter={StaticResource InvertedBoolConverter}}" />
                        <Border Padding="10,6"
                                Margin="18"
                                BackgroundColor="#CC0F172A"
                                StrokeThickness="0"
                                IsVisible="{Binding HasRegionHint}"
                                VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding RegionHintText}"
                                   FontSize="13"
                                   TextColor="#FFFFFF"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1"
                  BackgroundColor="#FFFFFF"
                  Padding="34"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="18">
                <ProgressBar Progress="{Binding UploadProgress}"
                             ProgressColor="#0F766E"
                             BackgroundColor="#E2E8F0"
                             HeightRequest="6" />

                <Border Grid.Row="1"
                        Padding="24"
                        BackgroundColor="#EFF6FF"
                        Stroke="#DBEAFE">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <controls:FormattedAnswerView x:Name="AnswerContentView"
                                                  Text="{Binding ResultText}"
                                                  IsStreaming="{Binding IsStreamingAnswer}"
                                                  AnswerFontSize="16"
                                                  AnswerTextColor="#334155" />
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="18">
                    <Button Text="上传并讲解"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#0F766E"
                            TextColor="#FFFFFF"
                            Command="{Binding SubmitCommand}" />
                    <Button Grid.Column="1"
                            Text="生成类似题"
                            IsEnabled="False"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#0F172A"
                            TextColor="#FFFFFF" />
                    <Button Grid.Column="2"
                            Text="加入错题本"
                            IsEnabled="False"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="18"
                            BackgroundColor="#F1F5F9"
                            TextColor="#94A3B8" />
                </Grid>
            </Grid>
        </Grid>
        <controls:LoadingOverlay Grid.RowSpan="2" IsLoading="{Binding IsBlockingLoading}" LoadingText="AI老师正在看图..." />
    </Grid>
</ContentPage>

