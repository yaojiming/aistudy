<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             x:Class="AiTutor.Maui.Views.WrongQuestionDetailPage"
             Shell.NavBarIsVisible="False"
             Title="错题详情">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="104,*">
        <Grid Padding="42,22" BackgroundColor="#FFFFFF">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="错题详情" FontSize="32" FontAttributes="Bold" TextColor="#1E293B" />
                <Label Text="左侧看原题和答案，右侧看错因、讲解和复习操作" FontSize="16" TextColor="#94A3B8" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="42" ColumnDefinitions="1*,1*" ColumnSpacing="30">
            <Border Padding="38" BackgroundColor="#FFFFFF" Stroke="#EEF2F7">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="24">
                    <Label Text="原题与答案" FontSize="34" FontAttributes="Bold" TextColor="#1E293B" />
                    <Border Padding="14,8" BackgroundColor="#F8FAFC" StrokeThickness="0" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Grade}" FontSize="18" FontAttributes="Bold" TextColor="#64748B" />
                    </Border>
                    <Label Text="{Binding QuestionText}" FontSize="44" FontAttributes="Bold" TextColor="#1E293B" LineHeight="1.1" />
                    <Border Padding="24" BackgroundColor="#F8FAFC" Stroke="#EEF2F7">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Label Text="{Binding StudentAnswer, StringFormat='学生答案：{0}'}" FontSize="26" TextColor="#475569" />
                    </Border>
                    <Border Padding="24" BackgroundColor="#F0FDFA" Stroke="#CCFBF1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Label Text="{Binding CorrectAnswer, StringFormat='正确答案：{0}'}" FontSize="26" FontAttributes="Bold" TextColor="#0F766E" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Padding="38" BackgroundColor="#FFFFFF" Stroke="#EEF2F7">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38" />
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="24">
                        <Label Text="错因与复习" FontSize="34" FontAttributes="Bold" TextColor="#1E293B" />
                        <controls:AnswerStepView StepNo="1" TitleText="错误原因" BodyText="{Binding ErrorReason}" />
                        <controls:AnswerStepView StepNo="2" TitleText="AI 讲解" BodyText="{Binding AiExplanation}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="70,70" ColumnSpacing="16" RowSpacing="16">
                            <Button Text="语音问老师" IsEnabled="False" FontSize="21" FontAttributes="Bold" CornerRadius="24" BackgroundColor="#F1F5F9" TextColor="#94A3B8" Command="{Binding VoiceAskCommand}" />
                            <Button Grid.Column="1" Text="AI老师视频讲解" IsEnabled="False" FontSize="21" FontAttributes="Bold" CornerRadius="24" BackgroundColor="#F1F5F9" TextColor="#94A3B8" Command="{Binding AvatarExplainCommand}" />
                            <Button Grid.Row="1" Text="分阶段练习" IsEnabled="False" FontSize="21" FontAttributes="Bold" CornerRadius="24" BackgroundColor="#FEF3C7" TextColor="#D97706" Command="{Binding StagePracticeCommand}" />
                            <Button Grid.Row="1" Grid.Column="1" Text="完成复习" FontSize="21" FontAttributes="Bold" CornerRadius="24" BackgroundColor="#0F766E" TextColor="#FFFFFF" Command="{Binding ReviewDoneCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
