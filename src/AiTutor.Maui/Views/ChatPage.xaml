<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiTutor.Maui.Views.ChatPage"
             Shell.NavBarIsVisible="False"
             Title="&#x95EE; AI"
             BackgroundColor="#F7F9FC">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="58,*,106" BackgroundColor="#F7F9FC">
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,1" Radius="5" Opacity="0.07" />
            </Border.Shadow>
            <Grid Padding="22,8,26,8" ColumnDefinitions="40,14,38,16,*,120,94" ColumnSpacing="6">
                <Button Text="&#x2039;"
                        FontSize="30"
                        FontAttributes="Bold"
                        BackgroundColor="#F5F8FC"
                        TextColor="#2A405C"
                        CornerRadius="15"
                        Padding="0"
                        Command="{Binding BackCommand}" />
                <Border Grid.Column="2" BackgroundColor="#DCEBFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="&#x5B66;"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#246BFF"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="4" Spacing="0" VerticalOptions="Center">
                    <Label Text="AI &#x5B66;&#x4E60;&#x76F4;&#x901A;&#x8F66;"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#10213A"
                           LineBreakMode="NoWrap" />
                    <Label Text="FIVE GRADE &#x00B7; MATHEMATICS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#91A1BA" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="&#x601D;&#x8003;" FontSize="11" TextColor="#64748B" VerticalTextAlignment="Center" />
                    <Switch IsToggled="{Binding IsThinkingModeEnabled}" Scale="0.8" />
                </HorizontalStackLayout>
                <Button Grid.Column="6"
                        Text="&#x65B0;&#x4F1A;&#x8BDD;"
                        FontSize="13"
                        FontAttributes="Bold"
                        BackgroundColor="#FFFFFF"
                        TextColor="#91A1BA"
                        BorderColor="#E1E8F2"
                        BorderWidth="1"
                        CornerRadius="18"
                        Padding="0"
                        Command="{Binding NewSessionCommand}" />
            </Grid>
        </Border>

        <ScrollView x:Name="MessagesScroll" Grid.Row="1" Padding="26,0" BackgroundColor="#F7F9FC">
            <VerticalStackLayout x:Name="MessagesStack"
                                 BindableLayout.ItemsSource="{Binding Messages}"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Margin="0,10,0,12"
                                             Spacing="6"
                                             MaximumWidthRequest="940"
                                             HorizontalOptions="{Binding BubbleHorizontalOptions}">
                            <Border Padding="28,20"
                                    BackgroundColor="{Binding BubbleColor}"
                                    Stroke="#E5EAF1"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Label Text="{Binding MessageText}"
                                       FontSize="17"
                                       LineHeight="1.36"
                                       TextColor="{Binding MessageColor}"
                                       LineBreakMode="WordWrap" />
                            </Border>
                            <Label Text="{Binding SpeakerText}"
                                   FontSize="11"
                                   CharacterSpacing="1"
                                   TextColor="{Binding SpeakerColor}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#FFFFFF" StrokeThickness="0">
            <Grid RowDefinitions="1,*" BackgroundColor="#FFFFFF">
                <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#EEF2F7" />
                <Grid Grid.Row="1"
                      Padding="18,18,44,12"
                      ColumnDefinitions="48,10,48,18,1,22,*"
                      ColumnSpacing="0"
                      BackgroundColor="#FFFFFF">
                    <Border Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="#F4F7FB"
                            VerticalOptions="Start"
                            Margin="0,10,0,0"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PhotoPlaceholderCommand}" />
                        </Border.GestureRecognizers>
                        <Grid Padding="12">
                            <Path Stroke="#91A1BA"
                                  StrokeThickness="2.6"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M4,8 L8,8 L10,5 L14,5 L16,8 L20,8 L20,19 L4,19 Z M12,11 A4,4 0 1 0 12,19 A4,4 0 1 0 12,11" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="#F4F7FB"
                            VerticalOptions="Start"
                            Margin="0,10,0,0"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoicePlaceholderCommand}" />
                        </Border.GestureRecognizers>
                        <Grid Padding="12">
                            <Path Stroke="#91A1BA"
                                  StrokeThickness="2.6"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12,4 A3,3 0 0 0 9,7 L9,12 A3,3 0 0 0 15,12 L15,7 A3,3 0 0 0 12,4 M6,11 A6,6 0 0 0 18,11 M12,17 L12,21 M9,21 L15,21" />
                        </Grid>
                    </Border>
                    <BoxView Grid.Column="4"
                             WidthRequest="1"
                             HeightRequest="44"
                             BackgroundColor="#E8EEF7"
                             VerticalOptions="Start"
                             Margin="0,12,0,0" />
                    <Border Grid.Column="6"
                            HeightRequest="62"
                            Padding="24,0,8,0"
                            BackgroundColor="#F8FAFD"
                            Stroke="#EEF2F8"
                            StrokeThickness="1"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="7" Opacity="0.05" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,50" ColumnSpacing="8">
                            <Entry Text="{Binding QuestionText}"
                                   Placeholder="&#x8F93;&#x5165;&#x4F60;&#x60F3;&#x5B66;&#x4E60;&#x7684;&#x5185;&#x5BB9;&#xFF0C;&#x8001;&#x5E08;&#x5E26;&#x4F60;&#x6DF1;&#x5165;&#x6D45;&#x51FA;..."
                                   FontSize="15"
                                   TextColor="#334155"
                                   PlaceholderColor="#9BA6B8"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="Never"
                                   ReturnType="Send"
                                   ReturnCommand="{Binding SubmitCommand}" />
                            <Button Grid.Column="1"
                                    Text="{Binding SendButtonText}"
                                    FontSize="22"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="#AFC6FF"
                                    TextColor="#FFFFFF"
                                    CornerRadius="15"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Command="{Binding SubmitCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                Padding="14,7"
                BackgroundColor="#2563EB"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,70,0,0"
                IsVisible="{Binding HasToast}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <Label Text="{Binding ToastMessage}" TextColor="#FFFFFF" FontSize="14" />
        </Border>
    </Grid>
</ContentPage>
