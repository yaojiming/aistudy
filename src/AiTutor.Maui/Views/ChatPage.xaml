<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="AiTutor.Maui.Views.ChatPage"
             Shell.NavBarIsVisible="False"
             Title="问 AI"
             BackgroundColor="#F7F9FC">

    <ContentPage.Resources>
        <!-- 页面默认文字大小，聊天气泡内如果没有单独写死 FontSize，会继承 14 -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="62,*,120"
          BackgroundColor="#F7F9FC">

        <!-- 顶部 Header -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,1"
                        Radius="5"
                        Opacity="0.07" />
            </Border.Shadow>

            <AbsoluteLayout>

                <!-- 返回按钮 -->
                <Border AbsoluteLayout.LayoutBounds="22,10,42,42"
                        BackgroundColor="#F5F8FC"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>

                    <shapes:Path Data="M28,10 L16,21 L28,32"
                                 Stroke="#2A405C"
                                 StrokeThickness="3.2"
                                 StrokeLineCap="Round"
                                 StrokeLineJoin="Round"
                                 Fill="Transparent"
                                 WidthRequest="38"
                                 HeightRequest="38"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>

                <!-- Logo -->
                <Border AbsoluteLayout.LayoutBounds="80,11,40,40"
                        BackgroundColor="#DCEBFF"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>

                    <shapes:Path Data="M7,18 L22,10 L37,18 L22,25 Z M13,23 L13,30 C18,35 26,35 31,30 L31,23 M37,18 L37,28"
                                 Stroke="#246BFF"
                                 StrokeThickness="2.5"
                                 StrokeLineCap="Round"
                                 StrokeLineJoin="Round"
                                 Fill="Transparent"
                                 WidthRequest="36"
                                 HeightRequest="36"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>

                <!-- 标题 -->
                <VerticalStackLayout AbsoluteLayout.LayoutBounds="136,10,420,46">

                    <Label Text="AI 学习直通车"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#10213A"
                           VerticalTextAlignment="Center"
                           LineBreakMode="NoWrap" />

                </VerticalStackLayout>

            </AbsoluteLayout>
        </Border>


        <!-- 中间聊天区 -->
        <Grid Grid.Row="1"
              Padding="26,0,26,0"
              BackgroundColor="#F7F9FC">

            <CollectionView ItemsSource="{Binding Messages}"
                            BackgroundColor="Transparent"
                            SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- 
                            聊天气泡字体：
                            这里不再使用 Scale="0.92"，避免整体缩放导致文字小于 14。
                            如果 ChatBubbleView.xaml 内部写死 FontSize，需要在 ChatBubbleView.xaml 里同步改成 14。
                        -->
                        <controls:ChatBubbleView Margin="0,10,0,12"
                                                 AnchorX="0"
                                                 SpeakerText="{Binding SpeakerText}"
                                                 MessageText="{Binding MessageText}"
                                                 BubbleColor="{Binding BubbleColor}"
                                                 MessageColor="{Binding MessageColor}"
                                                 SpeakerColor="{Binding SpeakerColor}"
                                                 BubbleHorizontalOptions="{Binding BubbleHorizontalOptions}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>


        <!-- 底部输入区 -->
        <Border Grid.Row="2"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0">

            <Grid BackgroundColor="#FFFFFF"
                  RowDefinitions="1,*">

                <BoxView Grid.Row="0"
                         HeightRequest="1"
                         BackgroundColor="#EEF2F7" />

                <Grid Grid.Row="1"
                      Padding="18,34,48,16"
                      ColumnDefinitions="48,10,48,18,1,22,*"
                      ColumnSpacing="0"
                      BackgroundColor="#FFFFFF">

                    <!-- 拍照按钮 -->
                    <Border Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="#F4F7FB"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            Margin="0,10,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PhotoPlaceholderCommand}" />
                        </Border.GestureRecognizers>

                        <!-- 图标改小：Scale 从 1 缩到 0.78 -->
                        <shapes:Path Data="M10,20 L17,20 L20,15 L33,15 L36,20 L43,20 L43,38 L10,38 Z M26.5,34 C30.5,34 34,30.5 34,26.5 C34,22.5 30.5,19 26.5,19 C22.5,19 19,22.5 19,26.5 C19,30.5 22.5,34 26.5,34 Z"
                                     Stroke="#91A1BA"
                                     StrokeThickness="2.3"
                                     StrokeLineCap="Round"
                                     StrokeLineJoin="Round"
                                     Fill="Transparent"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     Scale="0.58"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                    </Border>

                    <!-- 语音按钮 -->
                    <Border Grid.Column="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="#F4F7FB"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            Margin="0,10,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoicePlaceholderCommand}" />
                        </Border.GestureRecognizers>

                        <!-- 图标改小：Scale 从 1 缩到 0.78 -->
                        <shapes:Path Data="M27,12 C23,12 21,15 21,20 L21,29 C21,34 23.5,37 27,37 C30.5,37 33,34 33,29 L33,20 C33,15 31,12 27,12 Z M15,28 C15,37 20,43 27,43 C34,43 39,37 39,28 M27,43 L27,50 M20,50 L34,50"
                                     Stroke="#91A1BA"
                                     StrokeThickness="2.3"
                                     StrokeLineCap="Round"
                                     StrokeLineJoin="Round"
                                     Fill="Transparent"
                                     WidthRequest="38"
                                     HeightRequest="38"
                                     Scale="0.58"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                    </Border>

                    <!-- 分割线 -->
                    <BoxView Grid.Column="4"
                             WidthRequest="1"
                             HeightRequest="44"
                             BackgroundColor="#E8EEF7"
                             VerticalOptions="Start"
                             Margin="0,12,0,0" />

                    <!-- 输入框 -->
                    <Border Grid.Column="6"
                            HeightRequest="68"
                            Padding="24,0,8,0"
                            BackgroundColor="#F8FAFD"
                            Stroke="#EEF2F8"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Offset="0,2"
                                    Radius="7"
                                    Opacity="0.05" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*,50"
                              ColumnSpacing="8">

                            <Entry Text="{Binding QuestionText}"
                                   Placeholder="输入你想学习的内容，老师带你深入浅出..."
                                   FontSize="15"
                                   TextColor="#334155"
                                   PlaceholderColor="#9BA6B8"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="Never"
                                   ReturnType="Send"
                                   ReturnCommand="{Binding SubmitCommand}" />

                            <!-- 发送按钮 -->
                            <Border Grid.Column="1"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="#AFC6FF"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SubmitCommand}" />
                                </Border.GestureRecognizers>

                                <!-- 发送图标改小：28 降到 22 -->
                                <shapes:Path Data="M12,12 L39,25 L12,38 L18,27 L28,25 L18,23 Z"
                                             Fill="#FFFFFF"
                                             WidthRequest="38"
                                             HeightRequest="38"
                                             Scale="0.58"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />

                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>


        <!-- Loading -->
        <controls:LoadingOverlay Grid.RowSpan="3"
                                 IsLoading="{Binding IsBusy}"
                                 LoadingText="AI老师正在思考..." />

        <!-- Toast -->
        <Border Grid.RowSpan="3"
                Padding="14,7"
                BackgroundColor="#2563EB"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,70,0,0"
                IsVisible="{Binding HasToast}"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>

            <Label Text="{Binding ToastMessage}"
                   TextColor="#FFFFFF"
                   FontSize="14" />
        </Border>

    </Grid>
</ContentPage>