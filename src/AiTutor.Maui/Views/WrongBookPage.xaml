<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AiTutor.Maui.Controls"
             x:Class="AiTutor.Maui.Views.WrongBookPage"
             Shell.NavBarIsVisible="False"
             Title="错题本">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="76,*">
        <Grid Padding="30,12" ColumnDefinitions="*,340,Auto" ColumnSpacing="14" BackgroundColor="#FFFFFF">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="错题本" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
                <Label Text="按学科、掌握状态和日期筛选错题" FontSize="13" TextColor="#94A3B8" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Padding="18,0" BackgroundColor="#F8FAFC" Stroke="#EEF2F7" VerticalOptions="Center" HeightRequest="44">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="搜索知识点或题目内容..." FontSize="14" TextColor="#94A3B8" VerticalTextAlignment="Center" />
            </Border>
            <Button Grid.Column="2" Text="手动录入" IsEnabled="False" FontSize="15" FontAttributes="Bold" WidthRequest="112" HeightRequest="44" CornerRadius="16" BackgroundColor="#EEF2FF" TextColor="#A5B4FC" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="0">
            <ScrollView BackgroundColor="#FFFFFF">
                <VerticalStackLayout Padding="26,30" Spacing="24">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="学科筛选" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                        <Picker ItemsSource="{Binding SubjectFilters}" SelectedItem="{Binding SelectedSubject}" FontSize="15" BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="掌握状态" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                        <Picker ItemsSource="{Binding MasteryFilters}" SelectedItem="{Binding SelectedMasteryStatus}" FontSize="15" BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="日期" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                        <DatePicker Date="{Binding SelectedDate}" FontSize="15" BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>
                    <Button Text="刷新" FontSize="16" FontAttributes="Bold" HeightRequest="46" CornerRadius="16" BackgroundColor="#2563EB" TextColor="#FFFFFF" />
                </VerticalStackLayout>
            </ScrollView>

            <CollectionView Grid.Column="1" ItemsSource="{Binding WrongQuestions}" Margin="30">
                <CollectionView.EmptyView>
                    <controls:EmptyStateView TitleText="没有错题" DescriptionText="做得不错，继续保持。" IconText="✓" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="18" VerticalItemSpacing="18" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <controls:WrongQuestionCard KnowledgePoint="{Binding KnowledgePoint}"
                                                        ErrorReason="{Binding ErrorReason}"
                                                        MasteryStatus="{Binding MasteryStatus}"
                                                        ReviewTime="{Binding NextReviewTime, StringFormat='下次复习：{0}'}"
                                                        RedoCommand="{Binding BindingContext.RedoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        ExplainCommand="{Binding BindingContext.ExplainCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        PracticeCommand="{Binding BindingContext.PracticeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.OpenDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
