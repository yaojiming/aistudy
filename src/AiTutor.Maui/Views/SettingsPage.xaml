<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiTutor.Maui.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             Title="设置">
    <Grid BackgroundColor="#F8FAFC" RowDefinitions="76,*">
        <Grid Padding="30,12"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16"
              BackgroundColor="#FFFFFF">
            <Button Text="‹"
                    FontSize="30"
                    FontAttributes="Bold"
                    BackgroundColor="#F5F8FC"
                    TextColor="#2A405C"
                    CornerRadius="15"
                    Padding="0"
                    WidthRequest="54"
                    HeightRequest="54"
                    Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="设置"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />
                <Label Text="设置当前年级和 AiTutor.Api 后端地址"
                       FontSize="13"
                       TextColor="#94A3B8" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              Padding="42"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="22"
              MaximumWidthRequest="980"
              HorizontalOptions="Center"
              VerticalOptions="Start">
            <Border Padding="28"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <Label Text="学习信息"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label Text="当前年级"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#64748B" />
                    <Picker ItemsSource="{Binding GradeOptions}"
                            SelectedItem="{Binding SelectedGrade}"
                            FontSize="18"
                            HeightRequest="54"
                            BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1"
                    Padding="28"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <Label Text="后端服务"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label Text="AiTutor.Api HTTP 地址"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#64748B" />
                    <Entry Text="{Binding ApiBaseUrl}"
                           FontSize="18"
                           HeightRequest="56"
                           Keyboard="Url"
                           Placeholder="例如 http://10.0.2.2:5088"
                           BackgroundColor="#F8FAFC"
                           TextColor="#1E293B" />
                    <Label Text="Android 模拟器访问电脑本机后端通常使用 http://10.0.2.2:5088；真机需要填写电脑局域网 IP。"
                           FontSize="13"
                           TextColor="#94A3B8"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   FontSize="14"
                   TextColor="#0F766E" />

            <Button Grid.Row="3"
                    Text="保存设置"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="58"
                    CornerRadius="18"
                    BackgroundColor="#2563EB"
                    TextColor="#FFFFFF"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
