<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="AiTutor.Maui.Controls.AnswerStepView">
    <Border Padding="14" BackgroundColor="#FFFFFF" Stroke="#DDE7E2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
            <Border BackgroundColor="#E8F2EF" HeightRequest="34" WidthRequest="34" VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="17" />
                </Border.StrokeShape>
                <Label Text="{Binding StepNo, Source={x:Reference Root}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="#2F7D7E" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="{Binding TitleText, Source={x:Reference Root}}" FontSize="16" FontAttributes="Bold" TextColor="#17324D" />
                <Label Text="{Binding BodyText, Source={x:Reference Root}}" FontSize="14" LineHeight="1.18" TextColor="#526170" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
