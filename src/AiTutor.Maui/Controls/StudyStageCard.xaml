<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="AiTutor.Maui.Controls.StudyStageCard">
    <Border Padding="18" BackgroundColor="#F8FAFB" Stroke="#DDE7E2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="8">
            <Label Text="{Binding StageTitle, Source={x:Reference Root}}" FontSize="20" FontAttributes="Bold" TextColor="#17324D" />
            <Label Text="{Binding StageGoal, Source={x:Reference Root}}" FontSize="17" TextColor="#526170" />
            <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}" ProgressColor="#2F7D7E" />
        </VerticalStackLayout>
    </Border>
</ContentView>
