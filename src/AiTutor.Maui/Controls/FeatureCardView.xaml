<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="AiTutor.Maui.Controls.FeatureCardView">
    <Border Padding="24"
            BackgroundColor="{Binding CardColor, Source={x:Reference Root}}"
            Stroke="#DDE7E2"
            StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding IconText, Source={x:Reference Root}}"
                   FontSize="34" />
            <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#17324D" />
            <Label Text="{Binding DescriptionText, Source={x:Reference Root}}"
                   FontSize="17"
                   LineHeight="1.18"
                   TextColor="#526170" />
        </VerticalStackLayout>
    </Border>
</ContentView>
