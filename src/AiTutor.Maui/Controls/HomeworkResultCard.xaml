<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="AiTutor.Maui.Controls.HomeworkResultCard">
    <Border Padding="18"
            BackgroundColor="{Binding CardColor, Source={x:Reference Root}}"
            Stroke="#F1E4D1"
            StrokeThickness="2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding QuestionNo, Source={x:Reference Root}}" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                <Border Grid.Column="1" Padding="12,6" BackgroundColor="#FFFFFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding StatusText, Source={x:Reference Root}}" FontSize="13" FontAttributes="Bold" TextColor="#EA580C" />
                </Border>
            </Grid>
            <Label Text="{Binding QuestionText, Source={x:Reference Root}}" FontSize="16" LineHeight="1.16" TextColor="#334155" />
            <Label Text="{Binding DetailText, Source={x:Reference Root}}" FontSize="14" TextColor="#64748B" LineHeight="1.16" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="查看讲解"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="38"
                        CornerRadius="13"
                        BackgroundColor="#EFF6FF"
                        TextColor="#2563EB"
                        Command="{Binding ExplainCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding ExplainCommandParameter, Source={x:Reference Root}}" />
                <Button Grid.Column="1"
                        Text="加入错题本"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="38"
                        CornerRadius="13"
                        BackgroundColor="#FFF1F2"
                        TextColor="#E11D48"
                        Command="{Binding AddWrongCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding AddWrongCommandParameter, Source={x:Reference Root}}" />
                <Button Grid.Column="2"
                        Text="生成同类题"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="38"
                        CornerRadius="13"
                        BackgroundColor="#F0FDFA"
                        TextColor="#0F766E"
                        Command="{Binding PracticeCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding PracticeCommandParameter, Source={x:Reference Root}}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>

