<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root"
             x:Class="AiTutor.Maui.Controls.EmptyStateView">
    <Border Padding="28"
            BackgroundColor="#F8FAFB"
            Stroke="#DDE7E2">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="22" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="{Binding IconText, Source={x:Reference Root}}" FontSize="42" HorizontalTextAlignment="Center" />
            <Label Text="{Binding TitleText, Source={x:Reference Root}}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#17324D" />
            <Label Text="{Binding DescriptionText, Source={x:Reference Root}}" FontSize="18" HorizontalTextAlignment="Center" TextColor="#60727F" />
        </VerticalStackLayout>
    </Border>
</ContentView>
