<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="ChatRoot"
             x:Class="AiTutor.Maui.Views.ChatPage"
             Shell.NavBarIsVisible="False"
             Title="问 AI"
             BackgroundColor="#F7F9FC">

    <Grid RowDefinitions="72,*,66" BackgroundColor="#F7F9FC">
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0">
            <Grid Padding="14,10" ColumnDefinitions="44,48,*,76" ColumnSpacing="10">
                <Button Text="‹"
                        FontSize="30"
                        FontAttributes="Bold"
                        BackgroundColor="#F5F8FC"
                        TextColor="#2A405C"
                        CornerRadius="16"
                        Padding="0"
                        Command="{Binding BackCommand}" />
                <Border Grid.Column="1" BackgroundColor="#DCEBFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="学"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#246BFF"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <Label Text="AI 学习直通车"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#10213A"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding LearningCaption}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#91A1BA" />
                </VerticalStackLayout>
                <Button Grid.Column="3"
                        Text="新会话"
                        FontSize="13"
                        FontAttributes="Bold"
                        BackgroundColor="#FFFFFF"
                        TextColor="#91A1BA"
                        BorderColor="#E1E8F2"
                        BorderWidth="1"
                        CornerRadius="18"
                        Padding="0"
                        Command="{Binding NewSessionCommand}" />
            </Grid>
        </Border>

        <ScrollView x:Name="MessagesScroll" Grid.Row="1" Padding="16,10" BackgroundColor="#F7F9FC">
            <VerticalStackLayout x:Name="MessagesStack"
                                 BindableLayout.ItemsSource="{Binding Messages}"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Margin="0,8,0,10"
                                             Spacing="5"
                                             MaximumWidthRequest="330"
                                             HorizontalOptions="{Binding BubbleHorizontalOptions}">
                            <Border Padding="18,14"
                                    BackgroundColor="{Binding BubbleColor}"
                                    Stroke="#E5EAF1"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="7">
                                    <Grid IsVisible="{Binding IsVoice}"
                                          ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <Button Text="▶"
                                                FontSize="13"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                CornerRadius="13"
                                                Padding="0"
                                                BackgroundColor="#EAF2FF"
                                                TextColor="#2563EB"
                                                IsVisible="{Binding HasVoice}"
                                                Command="{Binding BindingContext.PlayVoiceCommand, Source={x:Reference ChatRoot}}"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Column="1"
                                               Text="语音消息"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{Binding MessageColor}"
                                               VerticalTextAlignment="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding VoiceDurationText}"
                                               FontSize="13"
                                               TextColor="{Binding MessageColor}"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Label Text="{Binding VisibleText}"
                                           IsVisible="{Binding HasVisibleText}"
                                           FontSize="16"
                                           LineHeight="1.32"
                                           TextColor="{Binding MessageColor}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding StatusText}"
                                           FontSize="12"
                                           TextColor="{Binding SpeakerColor}"
                                           IsVisible="{Binding HasStatusText}" />
                                    <Label Text="{Binding ErrorMessage}"
                                           FontSize="12"
                                           TextColor="#EF4444"
                                           IsVisible="{Binding HasError}" />
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="{Binding VisibleSpeakerText}"
                                   FontSize="10"
                                   CharacterSpacing="1"
                                   TextColor="{Binding SpeakerColor}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#F3F4F6" StrokeThickness="0" ZIndex="10">
            <Grid Padding="10,8,10,10" ColumnDefinitions="46,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        BackgroundColor="#FFFFFF"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoicePlaceholderCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding InputModeButtonText}"
                           FontSize="21"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="#334155" />
                </Border>

                <Border Grid.Column="1"
                        Padding="12,0"
                        BackgroundColor="#FFFFFF"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid>
                        <Grid IsVisible="{Binding IsTextInputMode}">
                            <Entry Text="{Binding QuestionText}"
                                   Placeholder="输入你想学习的内容..."
                                   FontSize="15"
                                   TextColor="#334155"
                                   PlaceholderColor="#9BA6B8"
                                   BackgroundColor="Transparent"
                                   ReturnType="Send"
                                   ReturnCommand="{Binding SubmitCommand}" />
                        </Grid>

                        <Grid IsVisible="{Binding IsVoiceInputMode}">
                            <Border x:Name="HoldToTalkSurface"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#E5E7EB" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding HoldToTalkText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#334155"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       InputTransparent="True" />
                            </Border>

                            <GraphicsView BackgroundColor="Transparent"
                                          StartInteraction="OnHoldToTalkStartInteraction"
                                          DragInteraction="OnHoldToTalkDragInteraction"
                                          EndInteraction="OnHoldToTalkEndInteraction"
                                          CancelInteraction="OnHoldToTalkCancelInteraction" />
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="2"
                        Text="发送"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="#22C55E"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        Padding="14,0"
                        HeightRequest="46"
                        Command="{Binding SubmitCommand}"
                        IsVisible="{Binding CanShowTextSendButton}" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                WidthRequest="168"
                HeightRequest="168"
                Padding="18"
                BackgroundColor="{Binding VoiceRecordingOverlayColor}"
                Opacity="0.9"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding IsRecording}"
                ZIndex="20"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="🎙"
                       FontSize="46"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding VoiceRecordingWaveText}"
                       FontSize="15"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding VoiceRecordingOverlayText}"
                       FontSize="13"
                       TextColor="#FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.RowSpan="3"
                Padding="14,7"
                BackgroundColor="#2563EB"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,78,0,0"
                IsVisible="{Binding HasToast}"
                ZIndex="30"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <Label Text="{Binding ToastMessage}" TextColor="#FFFFFF" FontSize="14" />
        </Border>
    </Grid>
</ContentPage>
