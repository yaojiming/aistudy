<Window x:Class="AiTutor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiTutor WPF"
        Width="1600"
        Height="960"
        MinWidth="1280"
        MinHeight="760"
        Background="#F6F8FC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,34">
                    <TextBlock Text="小状元" FontSize="19" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="AI TUTOR WPF" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel>
                    <Button Content="首页" Command="{Binding NavigateHomeCommand}" Style="{StaticResource NavButton}" Background="#2563EB" BorderBrush="#2563EB" Foreground="White" Margin="0,0,0,9" />
                    <Button Content="问 AI" Command="{Binding NavigateChatCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="拍照讲题" Command="{Binding NavigatePhotoQuestionCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="作业检查" Command="{Binding NavigateHomeworkCheckCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="错题本" Command="{Binding NavigateWrongBookCommand}" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="教材" IsEnabled="False" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="学习计划" IsEnabled="False" Style="{StaticResource NavButton}" Margin="0,0,0,9" />
                    <Button Content="设置" Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavButton}" Margin="0,24,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28" />
    </Grid>
</Window>
