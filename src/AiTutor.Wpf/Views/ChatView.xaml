<UserControl x:Class="AiTutor.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
            <RowDefinition Height="106" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEF2F7">
            <Grid Margin="22,8,26,8" ColumnDefinitions="38,16,*,Auto,Auto,Auto">
                <Border Grid.Column="0" Background="#DCEBFF" CornerRadius="10">
                    <TextBlock Text="学" FontSize="24" FontWeight="Bold" Foreground="#246BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="AI 学习直通车" FontSize="19" FontWeight="Bold" Foreground="#10213A" />
                    <TextBlock Text="FIVE GRADE · MATHEMATICS" FontSize="11" FontWeight="Bold" Foreground="#91A1BA" />
                </StackPanel>

                <ComboBox Grid.Column="3" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" Width="112" FontSize="14" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" Width="112" FontSize="14" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <CheckBox Content="思考" IsChecked="{Binding IsThinkingModeEnabled}" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="新会话" Command="{Binding NewSessionCommand}" Style="{StaticResource SoftButton}" Width="94" Height="42" FontSize="13" Foreground="#91A1BA" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="26,12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,8,0,10" HorizontalAlignment="{Binding BubbleAlignment}">
                        <Border Background="{Binding BubbleBrush}"
                                CornerRadius="20"
                                Padding="22,16"
                                MaxWidth="{Binding BubbleMaxWidth}">
                            <TextBlock Text="{Binding MessageText}"
                                       Foreground="{Binding MessageBrush}"
                                       FontSize="19"
                                       TextWrapping="Wrap"
                                       LineHeight="30" />
                        </Border>
                        <TextBlock Text="{Binding SpeakerText}"
                                   Foreground="{Binding SpeakerBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding QuickQuestions}" Margin="26,0,26,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Command="{Binding DataContext.QuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SoftButton}"
                            Height="34"
                            MinHeight="34"
                            FontSize="13"
                            Padding="14,4"
                            Margin="0,0,10,0"
                            Foreground="#64748B" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#EEF2F7">
            <Grid Margin="18,18,44,12" ColumnDefinitions="48,10,48,18,1,22,*">
                <Button Grid.Column="0" Content="拍" Command="{Binding PhotoPlaceholderCommand}" Style="{StaticResource IconButton}" Margin="0,10,0,0" />
                <Button Grid.Column="2" Content="语" Command="{Binding VoicePlaceholderCommand}" Style="{StaticResource IconButton}" Margin="0,10,0,0" />
                <Border Grid.Column="4" Width="1" Height="44" Background="#E8EEF7" VerticalAlignment="Top" Margin="0,12,0,0" />

                <Border Grid.Column="6"
                        Height="62"
                        Padding="24,0,8,0"
                        Background="#F8FAFD"
                        BorderBrush="#EEF2F8"
                        BorderThickness="1"
                        CornerRadius="24"
                        VerticalAlignment="Top">
                    <Grid ColumnDefinitions="*,50">
                        <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                                 Foreground="#334155"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="0"
                                 ToolTip="输入你想学习的内容，老师带你深入浅出..." />

                        <Button Grid.Column="1"
                                Content="{Binding SendButtonText}"
                                Command="{Binding SubmitCommand}"
                                Width="42"
                                Height="42"
                                MinHeight="42"
                                Padding="0"
                                FontSize="22"
                                Background="#AFC6FF"
                                BorderBrush="#AFC6FF"
                                Foreground="White"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="4"
                Padding="14,7"
                Background="#2563EB"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,70,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasToast}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
