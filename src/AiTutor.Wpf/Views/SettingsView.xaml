<UserControl x:Class="AiTutor.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="设置" FontSize="34" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="这里保存 WPF 客户端本地设置，不保存任何模型 API Key。" FontSize="16" Foreground="#64748B" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" MaxWidth="920" HorizontalAlignment="Left">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="后端 HTTP 地址" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,8,0,20" Padding="10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前年级" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBox Text="{Binding CurrentGrade, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,8,0,20" Padding="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="当前学科" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBox Text="{Binding CurrentSubject, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,8,0,20" Padding="10" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="可选视觉模型名称（一行一个，或用逗号分隔）" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBox Text="{Binding ModelNamesText, UpdateSourceTrigger=PropertyChanged}" FontSize="18" MinHeight="120" Margin="0,8,0,20"
                             AcceptsReturn="True" TextWrapping="Wrap" Padding="10" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="拍照讲题默认模型" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBox Text="{Binding PhotoQuestionDefaultModel, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,8,0,20" Padding="10" />

                    <TextBlock Text="作业检查默认模型" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBox Text="{Binding HomeworkCheckDefaultModel, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Margin="0,8,0,20" Padding="10" />

                    <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="180" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StatusText}" FontSize="16" Foreground="#16A34A" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
