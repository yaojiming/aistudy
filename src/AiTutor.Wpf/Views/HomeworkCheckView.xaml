<UserControl x:Class="AiTutor.Wpf.Views.HomeworkCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="82" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.42*" />
            <ColumnDefinition Width="0.58*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White" BorderThickness="0,0,0,1" BorderBrush="#EEF2F7">
            <Grid Margin="22,8,26,8" ColumnDefinitions="38,16,*,Auto,Auto,Auto,Auto,Auto">
                <Border Background="#DCEBFF" CornerRadius="10">
                    <TextBlock Text="学" FontSize="24" FontWeight="Bold" Foreground="#246BFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="检查作业" FontSize="22" FontWeight="Bold" Foreground="#10213A" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="#91A1BA" />
                </StackPanel>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" Width="112" FontSize="14" Margin="0,0,12,0" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" Width="112" FontSize="14" Margin="0,0,12,0" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding ModelNames}" SelectedItem="{Binding SelectedModel}" Width="168" FontSize="14" Margin="0,0,12,0" />
                <CheckBox Grid.Column="6" Content="思考" IsChecked="{Binding EnableThinking}" FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <Button Content="选择图片" Command="{Binding SelectImageCommand}" Style="{StaticResource PrimaryButton}" Width="118" Height="42" FontSize="14" Margin="0,0,10,0" />
                    <Button Content="拍照" Command="{Binding CapturePhotoCommand}" Style="{StaticResource SoftButton}" Width="82" Height="42" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,18,18,0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="26" Padding="22">
            <Grid Width="520" Height="720" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                <ItemsControl ItemsSource="{Binding RegionBoxes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="520" Height="720" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="3"
                                        CornerRadius="8"
                                        Background="#2238BDF8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Background="#CC0F172A" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding QuestionNo}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="6,2" />
                                        <TextBlock Text="{Binding Marker}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,2,6,2" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="作业图片预览" Foreground="#CBD5E1" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="选择整页作业图片后显示" Foreground="#94A3B8" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,18,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SummaryText}" FontSize="17" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding QuestionNo}" FontSize="19" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="17" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StudentAnswer}" FontSize="15" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding CorrectAnswer}" FontSize="15" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding ShortResult}" FontSize="15" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedResult}">
                            <TextBlock Text="{Binding QuestionNo, StringFormat=第 {0} 题详情}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="{Binding QuestionText}" FontSize="16" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding StudentAnswer, StringFormat=学生答案：{0}}" FontSize="16" Foreground="#475569" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding CorrectAnswer, StringFormat=正确答案：{0}}" FontSize="16" Foreground="#475569" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ErrorReason, StringFormat=错因分析：{0}}" FontSize="16" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding Explanation}" FontSize="16" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="{Binding StartCheckButtonText}" Command="{Binding StartCheckCommand}" Style="{StaticResource PrimaryButton}" Width="170" />
            <Button Content="重新识别" IsEnabled="False" Style="{StaticResource SoftButton}" Width="150" Margin="14,0,0,0" />
            <Button Content="加入错题本" Command="{Binding AddWrongBookCommand}" Style="{StaticResource SoftButton}" Width="150" Margin="14,0,0,0" />
            <Button Content="生成类似题" Command="{Binding GenerateSimilarCommand}" Style="{StaticResource SoftButton}" Width="150" Margin="14,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
